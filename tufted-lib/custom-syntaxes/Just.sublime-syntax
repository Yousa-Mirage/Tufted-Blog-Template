name: Just
scope: source.just
file_extensions: [just, justfile, Justfile, .justfile]
contexts:
  main:
    - match: "^\\s*#.*$"
      scope: "comment.line.number-sign.just"
    - match: "^(import|mod)(\\?)?(?=[ \t]|$)"
      captures:
        1: "keyword.control.import.just"
        2: "keyword.operator.just"
      push: "expression-line"
    - match: "^(alias)\\s+([\\w-]+)\\s*(:=)\\s*([\\w:-]+)"
      captures:
        1: "keyword.declaration.just"
        2: "entity.name.function.just"
        3: "keyword.operator.assignment.just"
        4: "entity.name.function.just"
    - match: "^(unexport)\\s+([\\w-]+)"
      captures:
        1: "keyword.declaration.just"
        2: "variable.other.just"
    - match: "^(set)\\s+([\\w-]+)"
      captures:
        1: "keyword.declaration.just"
        2: "support.constant.setting.just"
      push: "expression-line"
    - match: "^(?:(export)\\s+)?([a-zA-Z_][\\w-]*)\\s*(:=)"
      captures:
        1: "keyword.declaration.just"
        2: "variable.other.just"
        3: "keyword.operator.assignment.just"
      push: "expression-line"
    - match: "^\\["
      scope: "punctuation.section.brackets.begin.just"
      push: "attributes"
    - match: "^(@)?([a-zA-Z_][\\w-]*)(?=[ \\t:]|$)"
      captures:
        1: "keyword.operator.quiet.just"
        2: "entity.name.function.just"
      push: "recipe-parameters"
    - match: "^[ \\t]+"
      push: "recipe-body"
  expression-line:
    - match: "$"
      pop: true
    - include: "comments"
    - include: "expression"
  comments:
    - match: "#.*$"
      scope: "comment.line.number-sign.just"
  attributes:
    - match: "\\]"
      scope: "punctuation.section.brackets.end.just"
      pop: true
    - match: "$"
      pop: true
    - include: "strings"
    - match: "[a-zA-Z_][\\w-]*(?=\\s*=)"
      scope: "variable.parameter.just"
    - match: "[a-zA-Z_][\\w-]*"
      scope: "support.function.attribute.just"
    - match: "[=:]"
      scope: "keyword.operator.just"
    - match: "[(),]"
      scope: "punctuation.separator.just"
  recipe-parameters:
    - match: "$"
      pop: true
    - include: "comments"
    - match: ":(?![:=])"
      scope: "keyword.operator.recipe.just"
      set: "dependencies"
    - match: "[+*$]"
      scope: "keyword.operator.parameter.just"
    - match: "="
      scope: "keyword.operator.assignment.just"
      push: "parameter-default"
    - match: "[a-zA-Z_][\\w-]*"
      scope: "variable.parameter.just"
  parameter-default:
    - match: "(?=[ \\t]|:(?!:)|$)"
      pop: true
    - include: "expression"
  dependencies:
    - match: "$"
      pop: true
    - include: "comments"
    - match: "\\("
      scope: "punctuation.section.parens.begin.just"
      push: "dependency-call"
    - match: "&&"
      scope: "keyword.operator.just"
    - match: "[a-zA-Z_][\\w-]*(?:::[a-zA-Z_][\\w-]*)*"
      scope: "entity.name.function.just"
  dependency-call:
    - match: "[a-zA-Z_][\\w-]*(?:::[a-zA-Z_][\\w-]*)*"
      scope: "entity.name.function.just"
      set: "parenthesized"
    - match: "\\)"
      pop: true
  parenthesized:
    - match: "\\)"
      scope: "punctuation.section.parens.end.just"
      pop: true
    - include: "expression"
  expression:
    - include: "strings"
    - match: "\\("
      scope: "punctuation.section.parens.begin.just"
      push: "parenthesized"
    - match: "(?x) \\b(\n  arch|num_cpus|os|os_family|shell|env_var|env_var_or_default|env|\n  is_dependency|invocation_directory|invocation_dir|invocation_directory_native|\n  invocation_dir_native|justfile|justfile_directory|justfile_dir|just_executable|\n  just_pid|source_file|source_directory|source_dir|module_file|module_directory|\n  module_dir|append|prepend|encode_uri_component|quote|replace|replace_regex|\n  trim|trim_end|trim_end_match|trim_end_matches|trim_start|trim_start_match|\n  trim_start_matches|capitalize|kebabcase|lowercamelcase|lowercase|\n  shoutykebabcase|shoutysnakecase|snakecase|titlecase|uppercamelcase|\n  uppercase|absolute_path|blake3|blake3_file|canonicalize|extension|\n  file_name|file_stem|parent_directory|parent_dir|without_extension|clean|join|\n  path_exists|error|assert|sha256|sha256_file|uuid|choose|datetime|\n  datetime_utc|semver_matches|style|cache_directory|cache_dir|config_directory|config_dir|\n  config_local_directory|config_local_dir|data_directory|data_dir|data_local_directory|\n  data_local_dir|executable_directory|executable_dir|home_directory|home_dir|which|require|read\n)\\b\n"
      scope: "support.function.builtin.just"
    - match: "(?x) \\b(\n  HEX|HEXLOWER|HEXUPPER|PATH_SEP|PATH_VAR_SEP|CLEAR|NORMAL|BOLD|ITALIC|UNDERLINE|INVERT|HIDE|\n  STRIKETHROUGH|BLACK|RED|GREEN|YELLOW|BLUE|MAGENTA|CYAN|WHITE|BG_BLACK|\n  BG_RED|BG_GREEN|BG_YELLOW|BG_BLUE|BG_MAGENTA|BG_CYAN|BG_WHITE\n)\\b\n"
      scope: "constant.language.just"
    - match: "\\b(?:true|false)\\b"
      scope: "constant.language.boolean.just"
    - match: "\\b(?:if|else)\\b"
      scope: "keyword.control.just"
    - match: "\\b\\d+(?:\\.\\d+)?\\b"
      scope: "constant.numeric.just"
    - match: ":=|==|!=|=~|&&|\\|\\||[+/=]"
      scope: "keyword.operator.just"
    - match: "[{},\\[\\]]"
      scope: "punctuation.separator.just"
    - match: "[a-zA-Z_][\\w-]*"
      scope: "variable.other.just"
  strings:
    - match: "(?:f|x)?\"\"\""
      scope: "string.quoted.double.just"
      push: "double-triple"
    - match: "(?:f|x)?'''"
      scope: "string.quoted.single.just"
      push: "single-triple"
    - match: "(?:f|x)?```"
      scope: "string.interpolated.just"
      push: "backtick-triple"
    - match: "(?:f|x)?\""
      scope: "string.quoted.double.just"
      push: "double"
    - match: "(?:f|x)?'"
      scope: "string.quoted.single.just"
      push: "single"
    - match: "(?:f|x)?`"
      scope: "string.interpolated.just"
      push: "backtick"
  double-triple:
    - meta_scope: "string.quoted.double.just"
    - match: "\"\"\""
      pop: true
    - match: "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)"
      scope: "constant.character.escape.just"
    - include: "interpolation"
  single-triple:
    - meta_scope: "string.quoted.single.just"
    - match: "'''"
      pop: true
    - include: "interpolation"
  backtick-triple:
    - meta_scope: "string.interpolated.just"
    - match: "```"
      pop: true
    - include: "interpolation"
  double:
    - meta_scope: "string.quoted.double.just"
    - match: "\""
      pop: true
    - match: "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)"
      scope: "constant.character.escape.just"
    - include: "interpolation"
  single:
    - meta_scope: "string.quoted.single.just"
    - match: "'"
      pop: true
    - include: "interpolation"
  backtick:
    - meta_scope: "string.interpolated.just"
    - match: "`"
      pop: true
    - include: "interpolation"
  interpolation:
    - match: "\\{\\{\\{\\{"
      scope: "constant.character.escape.just"
    - match: "\\{\\{"
      scope: "keyword.operator.interpolation.just"
      push: "interpolation-expression"
  interpolation-expression:
    - meta_scope: "meta.interpolation.just"
    - match: "\\}\\}"
      scope: "keyword.operator.interpolation.just"
      pop: true
    - include: "expression"
  recipe-body:
    - match: "$"
      pop: true
    - match: "\\G[@-]+"
      scope: "keyword.operator.recipe.just"
    - match: "\\G#!.*$"
      scope: "comment.line.shebang.just"
    - include: "interpolation"
